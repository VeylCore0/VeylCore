# VeylCore example server.cfg (native profile). Merge into your own config. Never commit your real license key.
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"
sv_licenseKey "changeme"
sv_maxclients 48
sv_enforceGameBuild 3751
set onesync on            # with txAdmin, enable OneSync in txAdmin settings instead

ensure mapmanager
ensure chat
# Do NOT start spawnmanager or basic-gamemode: veyl_spawn owns spawning.
# Do NOT start upstream qb-core: the [compat]/qb-core shim is the only resource allowed that name.

set mysql_connection_string "mysql://user:password@localhost/veylcore?charset=utf8mb4"

# Native profile: no ox_lib / ox_target / ox_inventory. (Transitional ox profile: see docs/DEPENDENCIES.md.)
ensure oxmysql
# Voice (proximity + phone calls). Start before veyl_hud. See docs/VOICE.md.
ensure pma-voice
setr voice_useNativeAudio true
setr voice_enableUi 0       # the VeylCore HUD shows talking and range
ensure veyl_lib
ensure veyl_core
ensure qb-core              # optional QBCore compatibility shim
ensure veyl_vehicles
ensure veyl_inventory
ensure veyl_target
ensure veyl_ui
ensure veyl_world
ensure veyl_interact
ensure veyl_appearance
ensure veyl_spawn
ensure veyl_characters
ensure veyl_hud
ensure veyl_needs
ensure veyl_vehiclekeys
ensure veyl_fuel
ensure veyl_banking
ensure veyl_jobs
ensure veyl_shops
ensure veyl_garages
ensure veyl_dealership
ensure veyl_mechanic
ensure veyl_weedprops       # custom weed models (must start before veyl_drugs)
ensure veyl_drugs
ensure sd-phone              # optional: in-hand phone prop models (sd_phone_black); falls back to the GTA phone without it
ensure veyl_phone
ensure veyl_loadscreen
# veyl_apartments needs the Starlite Motel MLO (free, by Zydrec): put zydrec-starlitemotel in your resources folder.
ensure zydrec-starlitemotel
ensure veyl_apartments
ensure veyl_doorlocks
ensure veyl_cityhall
ensure veyl_management
ensure veyl_medical
ensure veyl_emotes
ensure veyl_dispatch
ensure veyl_police
ensure veyl_mdt
ensure veyl_prison
ensure veyl_departments
ensure veyl_robbery
ensure veyl_fishing
ensure veyl_business
ensure veyl_crime
ensure veyl_heists
ensure veyl_boosting
ensure veyl_doctor
# ensure veyl_migrate      # only while importing from QBCore / QBox (docs/MIGRATION.md)
ensure veyl_delivery
ensure veyl_admin
ensure veyl_qbexample       # optional example

add_ace group.admin command allow
add_ace group.admin command.quit deny
add_ace group.admin veyl.admin allow
# add_principal identifier.fivem:YOUR_ID group.admin
